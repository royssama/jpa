<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.repository.mybatis.Test01Mapper">

    <select id="findByRequest" resultType="map">
        SELECT *
        FROM test01
        WHERE 1 = 1
        <if test="req.AUTH_ID != null and req.AUTH_ID != ''">
            AND AUTH_ID IN (#{req.AUTH_ID})
        </if>
        <if test="req.USER_ID != null and req.USER_ID != ''">
            AND USER_ID = #{req.USER_ID}
        </if>
    </select>
</mapper>
